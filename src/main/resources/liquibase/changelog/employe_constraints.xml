<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="fd91f112-4bb6-3961-959d-aa2cc7d3e394-2" author="app_core">
        <addForeignKeyConstraint
            baseColumnNames="sexe_id"
            baseTableName="employe"
            constraintName="fk_employe_sexe_id"
            referencedColumnNames="id"
            referencedTableName="sexe" />
        <addForeignKeyConstraint
            baseColumnNames="situation_familiale_id"
            baseTableName="employe"
            constraintName="fk_employe_situation_familiale_id"
            referencedColumnNames="id"
            referencedTableName="situation_familiale" />
        <addForeignKeyConstraint
            baseColumnNames="departement_id"
            baseTableName="employe"
            constraintName="fk_employe_departement_id"
            referencedColumnNames="id"
            referencedTableName="departement" />
    </changeSet>

    <changeSet id="fd91f112-4bb6-3961-959d-aa2cc7d3e394-3" author="app_core">
        <createIndex indexName="ix_employe_sexe_id" tableName="employe">
            <column name="sexe_id" />
        </createIndex>
        <createIndex indexName="ix_employe_situation_familiale_id" tableName="employe">
            <column name="situation_familiale_id" />
        </createIndex>
        <createIndex indexName="ix_employe_departement_id" tableName="employe">
            <column name="departement_id" />
        </createIndex>
    </changeSet>
</databaseChangeLog>
